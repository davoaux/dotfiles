let mapleader=" "

" Helix keybindings (https://github.com/chtenb/helix.vim), linked by modules/idea/idea.nix.
" Must be sourced first so the mappings below take precedence.
" Optional plugins used by it: KJump (gw), String Manipulation (&), Tab Shifter (space w h/j/k/l).
source ~/.config/ideavim/helix.idea.vim

set noerrorbells
set ignorecase
set clipboard=unnamed
set clipboard^=ideaput
set idearefactormode=keep
set NERDTree
let g:NERDTreeMapActivateNode="l"
let g:NERDTreeMapJumpParent="h"

" Mirror modules/common/helix.nix
nmap <F5> <Action>(EditorToggleShowWhitespaces)
nmap <c-s-f> <Action>(FindInPath)
nmap <c-s-k> <Action>(ShowIntentionActions)
nnoremap <Up> <nop>
nnoremap <Down> <nop>
nnoremap <Left> <nop>
nnoremap <Right> <nop>

nmap <c-j> :m +1<cr>
nmap <c-k> :m -2<cr>
nmap <c-p> <Action>(GotoFile)
nmap <c-s-p> <Action>(GotoAction)
nmap <c-s-o> <Action>(OptimizeImports)
nmap <leader>q <Action>(CloseEditor)
nmap <leader>n :NERDTreeToggle<cr>
nmap <leader>g <Action>(Gradle.ExecuteTask)
nmap <leader>m <Action>(Maven.ExecuteGoal)
